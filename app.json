{
  "expo": {
    "name": "Dranbleiben",
    "slug": "dranbleiben",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gamerrestaurant.dranbleiben"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.gamerrestaurant.dranbleiben"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-calendar",
        {
          "calendarPermission": "Dranbleiben trägt deine Termine in deinen Kalender ein und liest sie für Erinnerungen und den Wochenausblick."
        }
      ],
      [
        "expo-notifications",
        {}
      ]
    ]
  }
}
